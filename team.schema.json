{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sideline team site",
  "description": "Everything one team site renders. Player records deliberately have no birth date, birth year, address, medical or child-contact fields, and additionalProperties:false keeps them out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["team", "theme", "tabs"],
  "properties": {
    "$schema": { "type": "string" },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Full display name, e.g. \"Sample FC U10\"." },
        "shortName": { "type": "string", "description": "Used in the slim scroll bar and the home-screen title." },
        "club": { "type": "string" },
        "ageGroup": { "type": "string", "examples": ["U8", "U10", "U12"] },
        "season": { "type": "string" },
        "tagline": { "type": "string" },
        "pills": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
        "details": { "$ref": "#/$defs/labelValues", "description": "Rows in the Team tab's Team Details card." }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "dark", "paper"],
      "properties": {
        "primary": { "$ref": "#/$defs/color", "description": "Brand color. Date boxes, primary buttons, active tab." },
        "accent": { "$ref": "#/$defs/color", "description": "Highlight. Countdown kicker, current pathway step glow." },
        "dark": { "$ref": "#/$defs/color", "description": "Header, next-up card, jersey chips." },
        "paper": { "$ref": "#/$defs/color", "description": "Page background." },
        "logo": { "type": "string", "description": "Path relative to the page." },
        "headerPhoto": { "type": "string", "description": "Leads the phone's first screen. A field or grounds photo the team may publish." },
        "headerPhotoAlt": { "type": "string" }
      }
    },
    "tabs": {
      "type": "array",
      "description": "Order and visibility of the bottom tabs. A tab that is missing or enabled:false does not render.",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled"],
        "properties": {
          "id": { "enum": ["tournaments", "roster", "team", "gear", "snacks", "info"] },
          "enabled": { "type": "boolean" },
          "label": { "type": "string", "maxLength": 11 }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowFullNames": { "type": "boolean", "default": false, "description": "false shows players as first name plus last initial." },
        "rosterDisplay": { "enum": ["names", "jerseyNumbers"], "default": "names", "description": "jerseyNumbers hides every player name." },
        "showParentContacts": { "type": "boolean", "default": false, "description": "Lists guardian (adult) contacts. Never shown beside a child's full name." }
      }
    },
    "tournaments": { "type": "array", "items": { "$ref": "#/$defs/tournament" } },
    "roster": { "type": "array", "items": { "$ref": "#/$defs/player" } },
    "staff": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "examples": ["Head Coach", "Assistant Coach", "Team Manager"] },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      }
    },
    "pathway": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "current": { "type": "boolean" }
        }
      }
    },
    "kits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uniforms": { "type": "array", "items": { "$ref": "#/$defs/kit" } },
        "training": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shirt": { "$ref": "#/$defs/color" },
            "shorts": { "$ref": "#/$defs/color" },
            "socks": { "$ref": "#/$defs/color" },
            "items": { "type": "array", "items": { "type": "string" } }
          }
        },
        "order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supplier": { "type": "string" },
            "details": { "$ref": "#/$defs/labelValues" },
            "url": { "$ref": "#/$defs/url" },
            "buttonLabel": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "snacks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intro": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "buttonLabel": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "guide": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "items"],
        "properties": {
          "section": { "type": "string" },
          "intro": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["q", "a"],
              "properties": {
                "q": { "type": "string" },
                "open": { "type": "boolean" },
                "a": {
                  "type": "array",
                  "description": "Answer blocks. A string is a paragraph.",
                  "items": {
                    "oneOf": [
                      { "type": "string" },
                      { "type": "object", "additionalProperties": false, "required": ["list"], "properties": { "list": { "type": "array", "items": { "type": "string" } } } },
                      { "type": "object", "additionalProperties": false, "required": ["tip"], "properties": { "tip": { "type": "string" } } }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "showSidelineCredit": { "type": "boolean", "default": true },
        "sidelineCreditUrl": { "$ref": "#/$defs/url" }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$|^rgba?\\(" },
    "url": { "type": "string", "pattern": "^(https?://|mailto:|tel:|/|\\./|[a-zA-Z0-9_-]+/)" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "description": { "type": "string" }
      }
    },
    "labelValues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lat", "lon"],
      "description": "A playing site. lat/lon feed the map buttons and the weather page, which asks the National Weather Service for that exact point.",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Short slug that games use to say which field they are on, e.g. \"north-park\". Unique within the tournament." },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "hotelOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "note": { "type": "string" },
        "bookingUrl": { "$ref": "#/$defs/url" }
      }
    },
    "hotel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "kind": { "enum": ["host", "teamBlock"], "description": "host is the tournament's host hotel. teamBlock is a block the team booked itself." },
        "soldOut": { "type": "boolean", "default": false, "description": "Stays listed, dimmed and marked, so families know which hotel is gone." },
        "soldOutNote": { "type": "string" },
        "note": { "type": "string" },
        "bookingUrl": { "$ref": "#/$defs/url" },
        "infoUrl": { "$ref": "#/$defs/url" },
        "others": { "type": "array", "items": { "$ref": "#/$defs/hotelOption" } }
      }
    },
    "tournament": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "start", "end", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "state": { "type": "string" },
        "tag": { "type": "string" },
        "status": { "enum": ["local", "stayToPlay", "tba"] },
        "result": { "enum": ["gold", "silver", "bronze"], "description": "Completed tournaments only. Adds the medal banner." },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "games": {
          "type": "array",
          "description": "Optional game schedule. The weather page pins each game on its day's hourly strip, so families see the rain chance and wind at kickoff. Leave it out until the tournament publishes times.",
          "items": { "$ref": "#/$defs/game" }
        },
        "website": { "$ref": "#/$defs/url" },
        "signup": { "$ref": "#/$defs/link" },
        "fieldMap": { "$ref": "#/$defs/url", "description": "Field-map PDF or image." },
        "checkIn": { "type": "string" },
        "parking": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "dinner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place"],
          "properties": {
            "title": { "type": "string", "default": "Team dinner" },
            "when": { "type": "string" },
            "place": { "type": "string" },
            "address": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "hotel": { "$ref": "#/$defs/hotel" }
      }
    },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "24-hour local time at the field, e.g. \"08:30\"." },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "time", "opponent"],
      "properties": {
        "date": { "$ref": "#/$defs/date", "description": "Game day, between the tournament's start and end." },
        "time": { "$ref": "#/$defs/time", "description": "Kickoff, in the field's local time." },
        "arrive": { "$ref": "#/$defs/time", "description": "When players must be at the field. Only shown when set. The page never guesses an arrival time." },
        "field": { "type": "string", "description": "The id of one of this tournament's fields. Optional when the tournament has a single field." },
        "opponent": { "type": "string", "description": "Opponent team name. The page shows it as \"vs <opponent>\", so a bracket slot reads well as \"TBD · semifinal if we advance\"." }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstName", "jersey"],
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string", "description": "Rendered as an initial unless privacy.allowFullNames is true." },
        "jersey": { "type": "integer", "minimum": 0, "maximum": 99 },
        "guardians": {
          "type": "array",
          "description": "Adults only. Hidden unless privacy.showParentContacts is true.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "phone": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          }
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "shirt"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string", "examples": ["Home", "Away", "Third", "Gear"] },
        "type": { "enum": ["kit", "backpack"] },
        "shirt": { "$ref": "#/$defs/color", "description": "Shirt color, or the bag color for a backpack." },
        "shorts": { "$ref": "#/$defs/color", "description": "Defaults to the shirt color." },
        "socks": { "$ref": "#/$defs/color", "description": "Defaults to the shirt color." },
        "stroke": { "type": "string", "description": "Outline color. Needed for light kits on white." }
      }
    }
  }
}
